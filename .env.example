# Local development uses SQLite automatically when DATABASE_URL is omitted.
DATABASE_URL=postgresql+psycopg://parking_user:change-me@localhost:5432/parkflow
PORT=5000
CORS_ORIGINS=http://localhost:5000

# simulated is safe for development. http sends POST {action: open, session_id} to a barrier gateway.
BARRIER_MODE=simulated
BARRIER_URL=http://barrier-controller.local/open
BARRIER_TOKEN=change-me
